APP_ORIGIN=http://localhost:3000
PORT=3000
BIND_HOST=127.0.0.1
DATA_DIR=./data
# Set to 1 only behind the provided reverse proxy (which overwrites X-Real-IP).
TRUST_PROXY=0
# Optional. Remove immediately after admin creation / backup import.
ADMIN_PASSWORD=
BACKUP_PASSPHRASE=
# Optional phone verification; blank leaves shared-number signup disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_CHANNEL=sms
